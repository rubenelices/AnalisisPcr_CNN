{
  "schema": "multimodal_e19_v1",
  "clinical_columns": [
    "age",
    "HR",
    "HER2",
    "menopause"
  ],
  "experiment": {
    "experiment_id": "D36_edad_menopausia",
    "description": "CNN propia E19 desde cero + solo edad/menopausia; referencia sin aumentos",
    "data": {
      "root": "breastdcedl",
      "validation_fold": 0,
      "batch_size": 16,
      "num_workers": 0,
      "pin_memory": false
    },
    "model": {
      "channels": [
        16,
        32,
        64,
        128
      ],
      "convolutions_per_block": 2,
      "kernel_size": 3,
      "use_batch_norm": true,
      "dropout": 0.3,
      "pool_position": "between_convolutions",
      "input_representation": "pre_differences"
    },
    "training": {
      "epochs": 50,
      "learning_rate": 0.001,
      "weight_decay": 0.001,
      "loss": "normal",
      "threshold": 0.5,
      "seed": 42,
      "early_stopping_patience": 10,
      "scheduler_patience": 3,
      "scheduler_factor": 0.5,
      "monitor": "patient_roc_auc",
      "mixed_precision": false
    },
    "output_dir": "experiments/D36_age_menopause/run/resultados/fold_0_seed_42",
    "checkpoint_dir": "checkpoints/experimentos_datos/D36_edad_menopausia/fold_0_seed_42"
  },
  "clinical_input_columns": [
    "age",
    "menopause"
  ],
  "active_clinical_columns": [
    "age",
    "menopause"
  ]
}
