{
  "schema": "patient_features_v1",
  "pool_stage": "features",
  "experiment": {
    "experiment_id": "E57_estabilidad_f3",
    "description": "E57 original sin cambios de entrenamiento; fold adicional y curvas train/val eval comparables",
    "data": {
      "root": "breastdcedl",
      "validation_fold": 3,
      "batch_size": 16,
      "num_workers": 0,
      "pin_memory": false,
      "train_patients_per_batch": 2
    },
    "model": {
      "channels": [
        16,
        32,
        64,
        128
      ],
      "convolutions_per_block": 2,
      "kernel_size": 3,
      "use_batch_norm": true,
      "dropout": 0.3,
      "pool_position": "between_convolutions",
      "input_representation": "pre_differences"
    },
    "training": {
      "epochs": 50,
      "learning_rate": 0.001,
      "weight_decay": 0.001,
      "loss": "normal",
      "threshold": 0.5,
      "seed": 42,
      "early_stopping_patience": 10,
      "scheduler_patience": 3,
      "scheduler_factor": 0.5,
      "monitor": "patient_roc_auc",
      "mixed_precision": false,
      "objective": "patient_mean_probability"
    },
    "output_dir": "experimentos_equilibrados/E57_estabilidad/resultados/fold_3_seed_42",
    "checkpoint_dir": "checkpoints/experimentos_equilibrados/E57_estabilidad/fold_3_seed_42"
  }
}
